{
  "name": "cardapio-o-paraiba",
  "private": true,
  "version": "1.0.0",
  "description": "Cardápio digital do Restaurante O Paraíba — comida regional no Alto da Balança, Fortaleza",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
