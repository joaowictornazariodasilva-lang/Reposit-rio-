# Sem DATABASE_URL o sistema usa Postgres embutido (PGlite) em .data/pglite — ideal para demonstração.
# Em produção, aponte para o Postgres do Supabase/Neon/RDS:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Segredo da sessão (mín. 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# Popular com dados de demonstração quando o banco estiver vazio (true/false)
DEMO_SEED=true
