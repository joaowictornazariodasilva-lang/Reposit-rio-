    "geist": "1.7.2",
    "jose": "6.2.12",
    "lucide-react": "0.577.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "papaparse": "5.7.0",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.12",
