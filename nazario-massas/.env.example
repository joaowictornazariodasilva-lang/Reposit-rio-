# ─── Nazário Massas · variáveis de ambiente (apps/api/.env) ───
# Copie para apps/api/.env. NUNCA faça commit do arquivo .env.

# development | production
NODE_ENV=production
PORT=8787

# URL pública da loja (usada na checagem de origem do painel)
PUBLIC_URL=https://nazariomassas.com.br

# Serve o build do site pelo mesmo processo da API (deploy em um único serviço)
WEB_DIST=../web/dist

# Banco JSON local (troque por Supabase quando migrar — ver supabase/schema.sql)
DATA_FILE=data/db.json

# Sessão do painel: string aleatória longa (ex.: `openssl rand -hex 32`)
SESSION_SECRET=

# Login do painel /admin
ADMIN_EMAIL=admin@nazariomassas.com.br
# Gere com: npm run hash-password -- "sua-senha-forte"
ADMIN_PASSWORD_HASH=

# Atrás de um proxy reverso confiável (Nginx, Render, Railway…): 1
TRUST_PROXY=0

# ─── Pagamentos ───
# mock = Pix fictício para testes · asaas = cobranças reais
PAYMENT_PROVIDER=mock
# Chave da API do Asaas (Painel Asaas → Integrações → Chave de API)
ASAAS_API_KEY=
# sandbox | production
ASAAS_ENV=sandbox
# Token definido no webhook do Asaas (enviado no cabeçalho asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

# Limites anti-abuso por IP (padrões seguros)
LOGIN_RATE_LIMIT=5
ORDER_RATE_LIMIT=15
